<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ReplayViewer</RootNamespace>
    <AssemblyName>ReplayViewer</AssemblyName>
    <AssemblyTitle>Replay Viewer</AssemblyTitle>
    <Product>Replay Viewer</Product>
    <Description>Replay Viewer</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReplayViewer.Core\ReplayViewer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReplayViewer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>app.ico</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(NameFnPublicUrl)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NameFnPublicUrl</_Parameter1>
      <_Parameter2>$(NameFnPublicUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
