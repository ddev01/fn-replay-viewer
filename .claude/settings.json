{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:ui:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet format:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npm run typecheck:*)",
      "PowerShell(npm run test:ui:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./artifacts/**)",
      "Read(./test-results/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(./package-lock.json)"
    ]
  }
}
